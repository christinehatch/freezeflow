# Copy this file to .env before running `docker compose up` - Compose
# requires it to exist (docker-compose.yml loads it into the backend
# container), even if you leave every value at its default.
#
# See docs/deployment.md for the full deployment runbook.

# --- Backend (see backend/app/core/config.py for every field's default) ---

# "production" disables the /dev/* developer-tools routes (demo data
# seeding, database reset) that are only meant for local development.
FREEZEFLOW_ENVIRONMENT=production

# Comma-separated list of origins allowed to call the API. Set this to
# wherever the frontend is actually reachable - if you leave FRONTEND_PORT
# at its default below, that's http://localhost:8080. A public deployment
# needs its real domain here (e.g. https://freezeflow.example.com).
FREEZEFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Feedback notification email (ADR-0020) - all optional. Leave blank and
# the app still accepts every Feedback submission, it just won't email
# anyone about it.
FREEZEFLOW_SMTP_HOST=
FREEZEFLOW_SMTP_PORT=587
FREEZEFLOW_SMTP_USERNAME=
FREEZEFLOW_SMTP_PASSWORD=
FREEZEFLOW_SMTP_FROM_ADDRESS=
FREEZEFLOW_FEEDBACK_NOTIFY_EMAIL=

# --- Compose-only (not read by the backend itself) ---

# Host port the frontend is published on.
FRONTEND_PORT=8080
